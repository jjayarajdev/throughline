  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc --noEmit -p tsconfig.check.json",
    "start": "tsx src/server.ts",
    "type-check": "tsc --noEmit -p tsconfig.check.json",
    "clean": "rimraf dist .turbo",
