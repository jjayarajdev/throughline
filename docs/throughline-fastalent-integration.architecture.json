  "cards": [
    {
      "dot": "cyan",
      "title": "Who owns what",
      "items": [
        "fastalent: supply from agencies (tenants with one wallet and rate card) and gig recruiters; earnings, reputation, candidate ownership rules",
        "Throughline: the requisition (HRQ) and everything after intake — screening, interviews, offers, onboarding",
        "HR system: the employee record; Throughline hands over on join and stores the employee id"
      ]
    },
    {
      "dot": "rose",
      "title": "The contract between them",
      "items": [
        "Events: requisition.published, candidate.submitted, candidate.status_changed, interview.completed, hire.joined",
        "Hub is a public partner API: signed webhooks + outbox, idempotency keys, retries; Throughline is its first integration",
        "Mapping store keeps HRQ ↔ fastalent Role and Throughline candidate ↔ fastalent Submission"
      ]
    },
    {
      "dot": "emerald",
      "title": "Build order",
      "items": [
        "1 — Intake and status write-back (payouts flow on verified placements)",
        "2 — Screening Service, seeded from fastalent's JD-crux and resume-match code, used by both products",
        "3 — Interview and video-screening adapters · 4 — HR system connector · 5 — SSO and cross-pipeline analytics"
      ]
    }
  ]
