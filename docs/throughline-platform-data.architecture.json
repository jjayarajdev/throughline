  "cards": [
    {
      "dot": "cyan",
      "title": "What lives in core",
      "items": [
        "Taxonomy: skills, domains, sub-domains, locations, job levels — one id set both products store",
        "Organisations (vendors, agencies, client companies), people (candidates keyed by fingerprint), jobs (HRQ number and Role id on one row)",
        "Documents as storage keys (JDs, CVs) and the transactional outbox"
      ]
    },
    {
      "dot": "rose",
      "title": "Rules that keep it safe",
      "items": [
        "Product schemas hold foreign keys to core, never to each other — each app still deploys alone",
        "One writer per core table, enforced with Postgres roles and grants, not discipline",
        "Core migrations are additive only, with one owner; events leave through the outbox exactly once"
      ]
    },
    {
      "dot": "emerald",
      "title": "Migration",
      "items": [
        "1 — Create core in fastalent's Postgres; load taxonomy, 39 vendors, 289 jobs, 3,938 people from Throughline",
        "2 — Port Throughline to Npgsql: 13 procedures, 11 views, 9 raw-SQL sites, 5 computed columns; UI untouched",
        "3 — Cut fastalent over to core (roles, companies, recruiters, candidate fields); 4 — retire SQL Server and the internal webhooks"
      ]
    }
  ]
